<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE hibernate-configuration PUBLIC
	"-//Hibernate/Hibernate Configuration DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
	
	<hibernate-configuration>
	 
	     <session-factory>
	          <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
	          <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/hiberanno</property>
	          <property name="hibernate.connection.username">root</property>
	          <property name="hibernate.connection.password"></property>
	          <property name="show_sql">true</property>
	          <property name="hibernate.hbm2ddl.auto">update</property>
	          
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Doctor"/>
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Patient"/>
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Student"/>
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Teacher"/>
	          
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Students"/>
	          <mapping class="com.hiber.HibernateRelationalAnnotation.model.Courses"/>
	       
	     </session-factory>
	
	</hibernate-configuration>